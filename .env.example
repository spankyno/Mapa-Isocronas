# --- Servidor (Vercel > Settings > Environment Variables) ---
ORS_API_KEY=
CARTO_KEY=            # (también se acepta CATO_KEY)
CLERK_SECRET_KEY=
# Cuotas atómicas y límites de uso (Upstash Redis; Vercel Marketplace lo integra y crea estas variables)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Opcionales
ALLOWED_ORIGINS=https://mapaisocronas.vercel.app   # orígenes válidos de las sesiones (añade dominio propio)
GLOBAL_DAILY_LIMIT=400                              # tope diario de cálculos gratuitos (clave ORS)
# --- Cliente (clave publicable de Clerk; es pública por diseño) ---
CLERK_PUBLISHABLE_KEY=
